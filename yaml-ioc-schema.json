{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOC rule specification 2.1.0 (2026-08-07)",
  "type": "object",
  "required": ["title", "id", "references", "date", "iocs", "version"],
  "properties": {
    "title": {
      "type": "string",
      "description": "A brief title for the rule that should contain what the rule is supposed to detect.",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "description": "A short description of the rule and the malicious activity that can be detected.",
      "maxLength": 65535
    },
    "id": {
      "type": "string",
      "description": "A globally unique identifier for the IOC rule. This is recommended to be a UUID v4, but not mandatory.",
      "format": "uuid"
    },
    "references": {
      "type": "array",
      "description": "References to the source that the rule was derived from. These could be blog articles, technical papers, presentations or even tweets.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "description": "Creation date of the rule. Use the format YYYY-MM-DD",
      "pattern": "^\\d{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])$",
      "format": "date"
    },
    "modified": {
      "type": "string",
      "description": "Last modification date of the rule. Use the format YYYY-MM-DD",
      "pattern": "^\\d{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])$",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "description": "Tags to categorize a IOC rule.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "version": {
      "type": "string",
      "description": "Version of the used IOC schema",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-([0-9A-Za-z\\-]+(\\.[0-9A-Za-z\\-]+)*))?(\\+([0-9A-Za-z\\-]+(\\.[0-9A-Za-z\\-]+)*))?$"
    },
    "iocs": {
      "type": "object",
      "anyOf": [
        {"required": ["files"]},
        {"required": ["c2s"]},
        {"required": ["mutexes"]},
        {"required": ["named_pipes"]},
        {"required": ["events"]},
        {"required": ["hashes"]}
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "A set of file patterns that represent properties of files.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        },
        "c2s": {
          "description": "A set of indicators of compromise that represent properties of C2 communication.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        },
        "mutexes": {
          "description": "A set of indicators of compromise that represent properties of mutexes.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        },
        "named_pipes": {
          "description": "A set of indicators of compromise that represent properties of named pipes.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        },
        "events": {
          "description": "A set of indicators of compromise that represent properties of events.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        },
        "hashes": {
          "description": "A set of indicators of compromise that represent properties of hashes.",
          "allOf": [{ "$ref": "#/$defs/ruleSet" }]
        }
      }
    }
  },
  "$defs": {
    "line": {
      "$anchor": "line",
      "description": "A single IOC value",
      "type": "string",
      "not": {
        "description": "Must not contain (?",
        "pattern": "(^|[^\\\\])(\\\\\\\\)*\\(\\?"
      }
    },
    "stanza": {
      "$anchor": "stanza",
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "description": "A single value or multiple OR concatenated values in an IOC. This can be a string or an array of strings.",
          "oneOf": [
            { "$ref": "#/$defs/line" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/line" },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "type": {
          "type": "string",
          "description": "The type of IOC pattern. Accepted values: plain, regex. Default value: plain. If the value is plain, all characters are treated as literals. If the value is regex, the pattern is treated as a regular expression.",
          "enum": ["plain", "regex"]
        },
        "case_sensitive": {
          "type": "boolean",
          "format": "bool",
          "description": "Whether the pattern is case sensitive. Default value: false."
        }
      }
    },
    "object_type": {
      "$anchor": "object_type",
      "type": "string",
      "enum": [
        "AmCache entry",
        "DNS cache entry",
        "DetectionAdd MPLog entry",
        "DoublePulsar Handshake",
        "EMS detection MPLog entry",
        "EstimatedImpact MPLog entry",
        "KnowledgeDB entry",
        "LSA session",
        "Linux kernel module",
        "MFT entry",
        "MS Office connection cache entry",
        "PowerShell module analysis cache module entry",
        "SDN query MPLog entry",
        "SRUM Resource Usage Entry",
        "TeamViewer password",
        "Tomcat user",
        "USN entry",
        "Unix user",
        "User Access Log Entry",
        "WMI element",
        "WMI startup command",
        "Windows service",
        "Windows user",
        "antivirus exclusion",
        "antivirus product",
        "at job",
        "audit log entry",
        "authorized_keys entry",
        "autorun entry",
        "cron job",
        "eBPF program",
        "end of life report",
        "environment variable",
        "event",
        "eventlog entry",
        "file",
        "file chunk",
        "firewall rule",
        "groups.xml user",
        "hosts file entry",
        "hotfix summary",
        "init.d service",
        "journal log entry",
        "jump list entry",
        "log line",
        "logged in user",
        "mutex",
        "named pipe",
        "network connecting thread",
        "network session",
        "network share",
        "pipe list",
        "prefetch info",
        "process",
        "process connection",
        "process handle",
        "process start",
        "quarantine event",
        "raw firewall rule",
        "registered debugger",
        "registry key",
        "registry scheduled task",
        "registry value",
        "rootkit",
        "scheduled task",
        "shellbag entry",
        "shim cache",
        "shim cache entry",
        "shim database entry",
        "structured data from plugin",
        "systemd service",
        "thread",
        "user profile",
        "web download",
        "web page visit"
      ]
    },
    "rule": {
      "$anchor": "rule",
      "allOf": [{ "$ref": "#/$defs/stanza"}],
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": {
          "type": "integer",
          "description": "A score to indicate the confidence of the IOC. The higher the score, the more confident the IOC is malicious. The default value is 75.",
          "minimum": -100,
          "maximum": 100
        },
        "object_types": {
          "description": "An allowlist of object types that the IOC should be limited to. If omitted, the IOC is not limited to specific types. See https://github.com/NextronSystems/jsonlog/ for a list of all object types.",
          "type": "array",
          "items": { "$ref": "#/$defs/object_type" },
          "minItems": 1,
          "uniqueItems": true
        },
        "false_positives": {
          "oneOf": [
            { "$ref": "#/$defs/stanza" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/stanza" },
              "minItems": 2
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "ruleSet": {
      "$anchor": "ruleSet",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/rule"
        }
      ]
    }
  }
}
